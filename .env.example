ANTHROPIC_API_KEY=
# Agent and judge models are env-driven so a model swap is a config change
TRIAGE_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=field-triage-agent

# Tagged on every trace so experiments stay comparable
DATASET_VERSION=v1
LOG_LEVEL=INFO
